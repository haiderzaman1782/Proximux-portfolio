# Proximux portfolio — environment variables
# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# ── Contact form (api/index.js → POST /api/contact) ──
# Gmail account that sends and receives leads, plus a Gmail App Password
# (https://myaccount.google.com/apppasswords), NOT your normal password.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password

# ── RAG chatbot: knowledge base (Supabase) ──
# Project URL and the SERVICE ROLE key (server-side only — never expose to the client).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Table the corpus is seeded into and match_chunks reads (optional; default: chunks).
KNOWLEDGE_TABLE=chunks

# ── RAG chatbot: LLM (OpenAI-compatible endpoint — Groq or xAI Grok) ──
LLM_API_KEY=your-llm-api-key
# Chat-completions endpoint (optional; default is Groq).
#   Groq: https://api.groq.com/openai/v1/chat/completions
#   xAI:  https://api.x.ai/v1/chat/completions
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# Model id (optional; default: llama-3.1-8b-instant).
LLM_MODEL=llama-3.1-8b-instant

# ── Local dev server (api/index.js) ──
# Express listens on this port when NODE_ENV !== 'production' (optional; default: 5050).
PORT=5050

# ── Frontend (Vite) ──
# Base URL the chat widget calls. Leave unset to use same-origin '/api' (optional).
# VITE_RAG_API_URL=http://localhost:5050/api
